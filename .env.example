# Copy to .env and fill in. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_S=20
LLM_MAX_ATTEMPTS=2
# Answer with a rule-based parser (marked "degraded") when Gemini is down
FALLBACK_ENABLED=true
# How long an idle conversation is kept, in seconds
SESSION_TTL_S=1800
